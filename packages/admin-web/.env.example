# Admin web configuration
PAPERT_ADMIN_PORT=4180
PAPERT_ADMIN_STORE_PATH=./data/admin-controls.sqlite
PAPERT_ADMIN_ALLOWLIST=admin@company.com
PAPERT_ADMIN_HEADER=x-admin-user-id
PAPERT_ADMIN_CORS_ORIGINS=http://localhost:4173

# JWT signing secret (required for production)
PAPERT_ADMIN_JWT_SECRET=change-me-please

# 32-byte encryption key for provider API keys
PAPERT_ADMIN_ENC_KEY=change-me-please-32-bytes-min

# Bootstrap first admin if no users exist
PAPERT_ADMIN_BOOTSTRAP_EMAIL=admin@company.com
PAPERT_ADMIN_BOOTSTRAP_PASSWORD=change-me-please
